# Port 5433, not 5432. Both of our machines already run a native Windows
# PostgreSQL service on 5432, and Docker's published port is shadowed by it:
# the connection succeeds and reaches the WRONG database. Run the container
# with -p 5433:5432 and change this back to 5432 only if 5432 is free for you.
DATABASE_URL=postgresql+psycopg://postgres:crimenet@localhost:5433/crimenet
# JWT_SECRET must be at least 32 bytes or PyJWT warns. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-your-own-env
JWT_EXPIRE_HOURS=12
LLM_API_KEY=
LLM_PROVIDER=gemini
